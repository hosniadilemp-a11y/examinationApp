# ==============================================================================
# Configuration Plateforme d'Examen - PostgreSQL & Environnement
# ==============================================================================

# URL de connexion PostgreSQL
# Format : postgresql://<UTILISATEUR>:<MOT_DE_PASSE>@<HOTE>:<PORT>/<BASE>
DATABASE_URL=postgresql://exam_user:exam_password@localhost:5432/exam_db

# Clé secrète de signature des sessions JWT
SECRET_KEY=exam_quiz_lan_super_secret_production_key_change_me_998877

# Identifiants initiaux injectés dans la base de données (non hardcodés dans le code)
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_NAME=Super Administrateur

TEACHER_USER=prof_martin
TEACHER_PASS=prof123
TEACHER_NAME=Professeur Martin

STUDENT_USER=etudiant1
STUDENT_PASS=etudiant123
STUDENT_NAME=Alice Dupont

# Amorçage initial automatique en base (true / false)
AUTO_SEED_DEFAULT_USERS=true
