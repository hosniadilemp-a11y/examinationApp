[Unit]
Description=Plateforme ExamQuiz LAN Server (FastAPI / Uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=__APP_ROOT__
ExecStart=__APP_ROOT__/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
